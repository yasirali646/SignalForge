# Bright Data (required for production collection)
BRIGHTDATA_API_TOKEN=your_api_key_here
# Full MCP SSE URL (recommended) — from Bright Data MCP dashboard
BRIGHTDATA_MCP=https://mcp.brightdata.com/sse?token=YOUR_TOKEN&groups=advanced_scraping

# Forge Scout uses Bright Data MCP only (LangGraph) — OpenRouter optional/legacy
# OPENROUTER_API_KEY=
# BRIGHTDATA_MCP_GROUPS=advanced_scraping
# AGENT_MODE=brightdata_mcp

BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_SCRAPER_ZONE=web_scraper1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

# Database — local SQLite (default) or Neon PostgreSQL (production)
DATABASE_URL=sqlite:///./data/pulse.db
# Neon: create a project at https://neon.tech → Connection string → paste here
# (postgres:// and postgresql:// both work; sslmode=require is recommended)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
COLLECTOR_MODE=brightdata
# COLLECTOR_MODE=local  # fallback: direct HTTP (demo without API key)
# Pipeline uses REST zones when BRIGHTDATA_API_TOKEN is set; on zone errors it
# falls back to BRIGHTDATA_MCP (search_engine / scrape_as_markdown) if configured.

API_HOST=0.0.0.0
API_PORT=8000

# Autonomous collection (APScheduler)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=6

# Login (frontend + API protection)
AUTH_ENABLED=true
AUTH_USERNAME=name
AUTH_PASSWORD=password
AUTH_DEMO_USERNAME=demo
AUTH_DEMO_PASSWORD=demo
AUTH_SECRET_KEY=change-me-in-production-use-long-random-string
AUTH_TOKEN_EXPIRE_HOURS=24
# Demo account: read-only competitors, limited Forge Scout requests
DEMO_AGENT_REQUEST_LIMIT=5
